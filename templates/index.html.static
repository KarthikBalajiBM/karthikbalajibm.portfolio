<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karthik Balaji - Software Engineer</title>
    
    <!-- CSS Files -->
    <link rel="stylesheet" href="../static/css/minimalist.css">
    <link rel="stylesheet" href="../static/css/profile.css">
    <link rel="stylesheet" href="../static/css/centered-content.css">
    
    <!-- Fonts and Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Particles.js -->
    <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>
    
    <style>
        /* Override the base particles container for home page */
        #particles-js {
            display: none;
        }
        
        /* Home page specific particles container */
        #home-particles-js {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 1;
            background-color: var(--background-color);
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
        }
        
        .hero {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }
        
        .profile-img-container {
            margin-bottom: 2rem;
        }
        
        .availability-banner {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #444, #666);
            color: white;
            padding: 15px 30px;
            border-radius: 50px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
            text-align: center;
            font-weight: 500;
            font-size: 1.1rem;
            max-width: 90%;
            animation: pulse 2s infinite;
            z-index: 10;
            border: 2px solid rgba(255,255,255,0.2);
        }
        
        @keyframes pulse {
            0% {
                box-shadow: 0 5px 20px rgba(0,0,0,0.15);
            }
            50% {
                box-shadow: 0 5px 30px rgba(0,0,0,0.3);
            }
            100% {
                box-shadow: 0 5px 20px rgba(0,0,0,0.15);
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="navbar-container">
            <a href="index.html" class="navbar-logo">KB</a>
            <ul class="navbar-menu">
                <li><a href="about.html">About</a></li>
                <li><a href="projects.html">Projects</a></li>
                <li><a href="resume.html">Resume</a></li>
                <li><a href="contact.html">Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <section class="hero">
            <div id="home-particles-js"></div>
            <div class="hero-content">
                <div class="profile-img-container">
                    <div class="profile-img"></div>
                </div>
                <div class="hero-text">
                    <h1>Karthik Balaji B M</h1>
                    <h2>IT Student & Software Engineer</h2>
                    <div class="hero-buttons">
                        <a href="projects.html" class="btn btn-primary">My Work</a>
                        <a href="contact.html" class="btn btn-secondary">Contact</a>
                    </div>
                </div>
            </div>
            <div class="availability-banner">
                Currently seeking internship or full-time roles | Open to freelancing services
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-social">
                <a href="https://github.com/KarthikBalajiBM" target="_blank"><i class="fab fa-github"></i></a>
                <a href="https://www.linkedin.com/in/karthik-balaji-b-m" target="_blank"><i class="fab fa-linkedin"></i></a>
                <a href="mailto:karthikbalajibm@gmail.com"><i class="fas fa-envelope"></i></a>
            </div>
            <p class="footer-text">© 2025 Karthik Balaji B M. All rights reserved.</p>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="../static/js/main.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Home page specific particles with enhanced interactivity
            if (particlesJS) {
                particlesJS("home-particles-js", {
                    "particles": {
                        "number": {
                            "value": 100,
                            "density": {
                                "enable": true,
                                "value_area": 800
                            }
                        },
                        "color": {
                            "value": ["#555555", "#777777", "#999999"]
                        },
                        "shape": {
                            "type": "circle",
                            "stroke": {
                                "width": 0,
                                "color": "#000000"
                            }
                        },
                        "opacity": {
                            "value": 0.6,
                            "random": true,
                            "anim": {
                                "enable": true,
                                "speed": 1,
                                "opacity_min": 0.1,
                                "sync": false
                            }
                        },
                        "size": {
                            "value": 4,
                            "random": true,
                            "anim": {
                                "enable": true,
                                "speed": 2,
                                "size_min": 0.5,
                                "sync": false
                            }
                        },
                        "line_linked": {
                            "enable": true,
                            "distance": 120,
                            "color": "#777777",
                            "opacity": 0.5,
                            "width": 1
                        },
                        "move": {
                            "enable": true,
                            "speed": 2,
                            "direction": "none",
                            "random": true,
                            "straight": false,
                            "out_mode": "bounce",
                            "bounce": true,
                            "attract": {
                                "enable": true,
                                "rotateX": 600,
                                "rotateY": 1200
                            }
                        }
                    },
                    "interactivity": {
                        "detect_on": "window",
                        "events": {
                            "onhover": {
                                "enable": true,
                                "mode": "bubble"
                            },
                            "onclick": {
                                "enable": true,
                                "mode": "repulse"
                            },
                            "resize": true
                        },
                        "modes": {
                            "grab": {
                                "distance": 150,
                                "line_linked": {
                                    "opacity": 1
                                }
                            },
                            "bubble": {
                                "distance": 150,
                                "size": 10,
                                "duration": 2,
                                "opacity": 0.8,
                                "speed": 3
                            },
                            "repulse": {
                                "distance": 150,
                                "duration": 0.4
                            },
                            "push": {
                                "particles_nb": 4
                            },
                            "remove": {
                                "particles_nb": 2
                            }
                        }
                    },
                    "retina_detect": true
                });
            }
        });
    </script>
</body>
</html>
